# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# local | production. In "local", password-reset links are shown on screen
# when SMTP is not configured. Never use "local" on a public deployment.
APP_ENV=local
# Public base URL, no trailing slash. Used to build links in emails.
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# sqlite (local, zero setup) or mysql (hosted: Aiven, TiDB Cloud, ...)
DB_DRIVER=sqlite
# For sqlite, DB_DATABASE is a file path (relative to the project root).
DB_DATABASE=storage/database.sqlite

# For mysql:
# DB_DRIVER=mysql
# DB_HOST=your-host.aivencloud.com
# DB_PORT=3306
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=change-me
# DB_SSL=true            # TLS; required by Aiven and TiDB Cloud
# DB_SSL_CA=             # optional: CA certificate as a file path or pasted PEM
#                        # (Aiven needs its project CA; TiDB works with the system bundle)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=

# ---------------------------------------------------------------------------
# Email (optional). Leave SMTP_HOST empty to disable sending.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, port 587) or ssl (port 465)
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Address emails are sent from (must be allowed by your SMTP provider)
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Travel
# Where contact-form messages are emailed
CONTACT_TO=
